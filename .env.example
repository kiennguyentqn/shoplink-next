# ===== Mã hóa AES-GCM (src/lib/crypto.ts) =====
# Server đọc CRYPTO_SECRET, browser đọc NEXT_PUBLIC_CRYPTO_KEY -> HAI GIÁ TRỊ PHẢI GIỐNG NHAU.
CRYPTO_SECRET=doi-thanh-chuoi-ngau-nhien-dai
NEXT_PUBLIC_CRYPTO_KEY=doi-thanh-chuoi-ngau-nhien-dai

# ===== Chế độ kiểm tra thiết bị thật =====
# 1 = chạy bộ kiểm tra isGenuineMobile đầy đủ (chặn PC / F12 giả lập)
# 0 = isGenuineMobile() luôn trả về true
DEVICE_GUARD=0

# ===== Backend gốc mà các route /api/* sẽ gọi tới =====
UPSTREAM_API_URL=https://vohoainam.net
# Dùng cho redirect_token (/r/<token>) khi backend không trả url trực tiếp
NEXT_PUBLIC_UPSTREAM_ORIGIN=https://vohoainam.net
# Khóa ký request gửi lên backend (trước đây nằm trong code client)
SHIELD_SECRET=ShopLink_Shield_v2_9f8d2e4a7c1b5062

# (tuỳ chọn) User-Agent Android gửi lên backend; bỏ trống = dùng UA Chrome/Android mặc định
# ANDROID_UA=
